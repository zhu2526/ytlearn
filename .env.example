# 复制成 .env 后填写。不建也能跑，只是没有 LLM 提炼，走抽取式兜底。

# 任何 OpenAI 兼容接口
YTL_LLM_BASE=https://api.openai.com/v1
YTL_LLM_KEY=
YTL_LLM_MODEL=gpt-4o-mini

# 回看时让模型读画面（可选，留空则只导出帧）
YTL_VISION_MODEL=

# 数据目录
YTL_DATA_DIR=./data

# 下载清晰度上限与字幕优先级
YTL_MAX_HEIGHT=1080
YTL_SUB_LANGS=zh-Hans,zh,en

# 本地转写模型（需要 pip install faster-whisper）
YTL_WHISPER_MODEL=small
